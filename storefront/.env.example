# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID="your-lamgold-sanity-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-28"
NEXT_PUBLIC_SANITY_STUDIO_URL="http://localhost:3333"
SANITY_API_READ_TOKEN="your-lamgold-sanity-read-token"

# Local only - used by `npm run content:push`. Never add this to Vercel.
SANITY_API_WRITE_TOKEN=""

# Shopify (LamGold's own store). Leave the token out until the store is
# connected: product pages then run on Sanity data alone.
SHOPIFY_STORE_DOMAIN="lamgold.myshopify.com"
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN="lamgold.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

# Presentation mode: Add To Cart works from Sanity data before Shopify is
# connected (checkout stays disabled). Remove once Shopify is live.
NEXT_PUBLIC_DEMO_CART="1"

# Custom enquiry form posts here (Formspree / Zapier / Make webhook)
ENQUIRY_WEBHOOK_URL=""
