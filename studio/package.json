{
  "name": "lamgold-studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "scripts": {
    "predev": "npm run extract-types",
    "dev": "sanity dev",
    "start": "sanity start",
    "prebuild": "npm run extract-types",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "extract-types": "sanity schema extract --enforce-required-fields --force",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/color-input": "6.1.5",
    "@sanity/icons": "^5.2.3",
    "@sanity/ui": "^4.3.0",
    "@sanity/vision": "^6.17.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "date-fns": "^4.4.0",
    "lodash.get": "^4.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "^7.8.2",
    "sanity": "^6.17.0",
    "slug": "^12.0.1",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@types/lodash.get": "^4.4.9",
    "@types/slug": "^5.0.9",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  }
}
